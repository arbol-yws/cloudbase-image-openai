# CloudBase environment ID (required)
CLOUDBASE_ENV_ID=your-env-id

# Optional server-side fallback credentials.
# Callers normally pass "Authorization: Bearer <CloudBase API Key>" per request.
# These values are only used when a request carries no Bearer token.
CLOUDBASE_APIKEY=

# Fallback alternative: Tencent Cloud API key pair.
# CLOUDBASE_APIKEY takes precedence when both are configured.
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# HTTP server port
PORT=8080

# Upstream (CloudBase) request timeout. Image generation can take several minutes.
UPSTREAM_TIMEOUT_MS=900000

# Maximum number of images accepted in one OpenAI request (n).
MAX_N=10

# Maximum number of concurrent CloudBase calls used to satisfy n > 1.
MAX_CONCURRENCY=3

# Whether the legacy I2I model enables prompt rewriting by default.
REVISE_PROMPT=true

# Timeout and size limit used when response_format=b64_json downloads the generated image.
B64_DOWNLOAD_TIMEOUT_MS=60000
MAX_B64_BYTES=20971520

# Maximum JSON request body size (images may be sent as base64/data URLs).
MAX_BODY_SIZE=32mb
